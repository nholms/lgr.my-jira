# =============================================================================
# Rust
# =============================================================================

# Compiled output and build artifacts
/target/

# Cargo lock file (keep for binaries, ignore for libraries)
# Cargo.lock  # Uncomment this line if your project is a library crate

# Generated by `cargo vendor` for offline builds
# vendor/  # Uncomment if you don't want to commit vendored dependencies

# Benchmark output from `cargo bench`
/criterion/

# Coverage reports (e.g., from cargo-tarpaulin or cargo-llvm-cov)
/coverage/
lcov.info
tarpaulin-report.html
tarpaulin-report.json

# Flamegraph output (e.g., from cargo-flamegraph)
flamegraph.svg
perf.data
perf.data.old


# =============================================================================
# Editors & IDEs
# =============================================================================

# VS Code
.vscode/
!.vscode/extensions.json   # Keep shared extension recommendations
!.vscode/settings.json     # Keep shared workspace settings (optional)

# JetBrains (RustRover, CLion, IntelliJ)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
Session.vim

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Helix
# (no persistent artifacts by default)


# =============================================================================
# Operating System
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory


# =============================================================================
# Environment & Secrets
# =============================================================================

.local

# dotenv files — never commit secrets
.env
.env.*
!.env.example   # Keep the example/template file

# Secret keys, certs, credentials
*.pem
*.key
*.p12
*.pfx


# =============================================================================
# Tooling & Misc
# =============================================================================

# direnv
.envrc

# cargo-audit / cargo-deny output
audit.json

# Profiling artifacts
*.profraw
*.profdata

# Fuzz testing corpus and artifacts (cargo-fuzz)
fuzz/target/
fuzz/corpus/
fuzz/artifacts/

# Temporary files
*.tmp
*.bak
*.orig

# =============================================================================
# AI Tools
# =============================================================================

# Ignore AI tool state directories
.cursor/
.windsurf/
.claude/
.cline/
.roo/
.junie/

# But keep shared rules/instruction files
!.cursorrules
!.windsurfrules
!.claude/CLAUDE.md
!AGENTS.md

# GitHub Copilot (Workspace context)
.github/copilot-instructions.md   # Remove this if you want to commit it
